# ── Banco ─────────────────────────────────────────────
# Dev local: npm run dev sobe um Postgres embutido (PGlite) nesta porta 5433.
# Produção: string do Neon/Supabase, ex. postgres://user:pass@host/db?sslmode=require
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres

# ── Segurança ─────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
IP_HASH_SALT=

# URL pública (vai dentro dos QR Codes e tags NFC!) — defina o domínio final antes de gravar plaquinhas
APP_URL=http://localhost:3000

# ── Cache (opcional) ──────────────────────────────────
# Sem estas, o cache do redirect fica em memória (ok para 1 servidor).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIRECT_CACHE_TTL_SECONDS=300

# ── Primeiro sócio (usado só por npm run db:seed) ─────
SEED_ADMIN_NAME=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Criptografia de tokens OAuth e configs de alerta (32 bytes base64url) ──
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ATENÇÃO: trocar esta chave invalida as integrações já conectadas.
ENCRYPTION_KEY=

# ── IA ────────────────────────────────────────────────
# Padrão: IA local via Ollama (sem custo por uso). Instale em https://ollama.com e baixe um modelo
# (ex.: ollama pull qwen2.5:7b). O modelo ativo pode ser trocado na tela Sistema.
AI_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b
# Opcional: usar a Claude API (paga por token) com AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# Cortes virais: modelo do Whisper (transcrição local) e fonte das legendas
WHISPER_MODEL=Xenova/whisper-small
CAPTION_FONT=

# ── Storage de vídeos/backups: Cloudflare R2 ou AWS S3 (vazio = disco local .data/uploads)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=1024

# ── OAuth das plataformas (crie os apps nos portais de desenvolvedor) ──
# Redirect URIs a cadastrar: {APP_URL}/api/integracoes/{google_business|youtube|meta|tiktok}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Webhook de avaliações (Pub/Sub push): {APP_URL}/api/webhooks/google-reviews?token=WEBHOOK_SECRET
WEBHOOK_SECRET=

# Worker: quantos jobs em paralelo
WORKER_CONCURRENCY=4
