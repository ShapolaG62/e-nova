{
  "name": "e-nova",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pglite-server --db=.data/pglite --port=5433 --max-connections=10 --run \"node scripts/dev.mjs\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed -- --demo",
    "typecheck": "tsc --noEmit",
    "db:local": "pglite-server --db=.data/pglite --port=5433 --max-connections=10",
    "worker": "tsx --conditions=react-server --env-file-if-exists=.env.local scripts/worker.ts",
    "setup:ytdlp": "node scripts/setup-ytdlp.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@aws-sdk/client-s3": "^3.1165.0",
    "@aws-sdk/s3-request-presigner": "^3.1165.0",
    "@base-ui/react": "^1.9.0",
    "@electric-sql/pglite": "^0.5.16",
    "@huggingface/transformers": "^4.3.2",
    "@upstash/redis": "^1.41.0",
    "archiver": "^8.0.0",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "ffmpeg-static": "^5.3.0",
    "jose": "^6.2.17",
    "lucide-react": "^1.70.0",
    "msedge-tts": "^2.1.1",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "otplib": "^13.6.0",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "ua-parser-js": "^2.0.10",
    "wavefile": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite-socket": "^0.2.19",
    "@tailwindcss/turbopack": "^4",
    "@types/archiver": "^8.0.0",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
